{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/explore", "destination": "/explore.html" },
    { "source": "/place", "destination": "/place.html" },
    { "source": "/quests", "destination": "/quests.html" },
    { "source": "/collection", "destination": "/collection.html" },
    { "source": "/journal", "destination": "/journal.html" },
    { "source": "/calendar", "destination": "/calendar.html" },
    { "source": "/planner", "destination": "/planner.html" },
    { "source": "/profile", "destination": "/profile.html" },
    { "source": "/login", "destination": "/login.html" },
    { "source": "/admin", "destination": "/admin.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
